[Unit]
Description=Tribunal PASS artifact audit (gu-log)
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=10min
EnvironmentFile=%h/.config/gu-log/tribunal.env
ExecStart=/bin/bash -lc ': "$${GU_LOG_DIR:?Missing GU_LOG_DIR in tribunal.env}"; cd "$$GU_LOG_DIR" || exit; if ! git fetch origin main >/dev/null 2>&1; then echo "WARN: unable to refresh origin/main; retrying once in 30 seconds" >&2; sleep 30; git fetch origin main >/dev/null || { echo "ERROR: unable to refresh origin/main; refusing to audit a cached ref" >&2; exit 1; }; fi; bash scripts/tribunal-audit-pass-commits.sh --range 2b1bc361..origin/main'
Environment=TZ=Asia/Taipei

[Install]
WantedBy=default.target
