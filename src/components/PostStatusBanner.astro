---
import type { PostStatus } from '../utils/post-status';

interface Props {
  type: Exclude<PostStatus, 'published'>;
  replacementHref?: string;
  replacementUrl?: string;
  replacementTitle?: string;
  replacementTicketId?: string;
  lang?: 'zh-tw' | 'en';
}

const {
  type,
  replacementHref,
  replacementUrl,
  replacementTitle,
  replacementTicketId,
  lang = 'zh-tw',
} = Astro.props;

const labels = {
  'zh-tw': {
    deprecated: {
      message: '⚠️ 這篇文章已被更完整的版本取代',
      fallback: '查看替代文章',
    },
    retired: {
      message:
        '⚠️ ShroomDog 覺得這篇品質不夠好，所以已經 retire 了。文章內容保留供參考，但不會再維護。',
    },
  },
  en: {
    deprecated: {
      message: '⚠️ This article has been replaced by a more complete version',
      fallback: 'View replacement article',
    },
    retired: {
      message:
        "⚠️ ShroomDog wasn't happy with this one, so it's been retired. The content is preserved for reference but won't be maintained.",
    },
  },
} as const;

const t = labels[lang][type];
const linkLabel = replacementTicketId
  ? `${replacementTicketId}${replacementTitle ? `：${replacementTitle}` : ''}`
  : replacementTitle || ('fallback' in t ? t.fallback : '');
---

<div
  class={`post-status-banner post-status-banner--${type}`}
  role="note"
  aria-live="polite"
  data-post-status-banner
  data-status={type}
  data-replacement-ticket-id={replacementTicketId ?? ''}
  data-replacement-url={replacementUrl ?? ''}
>
  <p>
    <span>{t.message}</span>
    {
      type === 'deprecated' &&
        (replacementHref ? (
          <>
            {' '}
            <a href={replacementHref}>{linkLabel}</a>
          </>
        ) : (
          <span class="replacement-label"> {linkLabel}</span>
        ))
    }
  </p>
</div>

<style>
  .post-status-banner {
    margin: 1rem 0 1.5rem;
    padding: 0.9rem 1rem;
    border-radius: 8px;
    color: var(--color-text);
  }

  .post-status-banner--deprecated {
    border: 1px solid color-mix(in srgb, var(--color-status-warning) 35%, transparent);
    border-left: 4px solid var(--color-status-warning);
    background: color-mix(in srgb, var(--color-status-warning) 8%, transparent);
  }

  .post-status-banner--retired {
    border: 1px solid color-mix(in srgb, var(--color-status-neutral) 35%, transparent);
    border-left: 4px solid var(--color-status-neutral);
    background: color-mix(in srgb, var(--color-status-neutral) 8%, transparent);
  }

  .post-status-banner p {
    margin: 0;
    line-height: 1.6;
  }

  .post-status-banner a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .post-status-banner a:hover {
    text-decoration: underline;
  }

  .replacement-label {
    font-weight: 600;
  }
</style>
