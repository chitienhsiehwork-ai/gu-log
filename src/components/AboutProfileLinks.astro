---
import { getAboutProfile, type AboutLang } from '../lib/about-profile';

interface Props {
  lang: AboutLang;
}

const { lang } = Astro.props;
const { links } = getAboutProfile(lang);
---

<ul class="about-links">
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          {...(link.key === 'email' ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
        >
          {link.label}
        </a>
        <span class="about-link-url">{link.href.replace(/^(https:\/\/|mailto:)/, '')}</span>
      </li>
    ))
  }
</ul>

<style>
  .about-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  .about-link-url {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
</style>
