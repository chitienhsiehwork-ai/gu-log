---
interface Props {
  lang?: 'zh-tw' | 'en';
}

import loginCtaRuntimeUrl from './login-cta-client.js?url&no-inline';

const { lang = 'zh-tw' } = Astro.props;
const configuredApiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.shroomdog.dev';
const parsedApiUrl = new URL(configuredApiUrl);

if (parsedApiUrl.protocol !== 'https:' && parsedApiUrl.protocol !== 'http:') {
  throw new Error('PUBLIC_API_URL must use http or https');
}

const apiUrl = parsedApiUrl.href.replace(/\/$/, '');
const loginUrl = `${apiUrl}/auth/github`;
const copy =
  lang === 'en'
    ? {
        loggedOutTitle: 'Want to improve this article?',
        loggedOutDescription: 'Log in to use AI features:',
        askAi: 'Ask AI — Select text for an explanation',
        editWithAi: 'Edit with AI — Select text to suggest an edit',
        login: 'Log in with GitHub',
        loggedInTitle: 'Select text to use AI features',
        loggedInPrefix: 'Logged in as:',
        logout: 'Log out',
      }
    : {
        loggedOutTitle: '想幫忙改進這篇文章？',
        loggedOutDescription: '登入後可以用 AI 功能：',
        askAi: 'Ask AI — 選取文字，請 AI 幫你解釋',
        editWithAi: 'Edit with AI — 選取文字，請 AI 建議修改',
        login: '使用 GitHub 登入',
        loggedInTitle: '選取文章中的文字來使用 AI 功能',
        loggedInPrefix: '已登入：',
        logout: '登出',
      };
---

<div class="login-cta-container" style="display: none;" data-login-cta>
  <div class="login-cta-card">
    <div class="login-cta-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"></path>
        <path d="M4 21a8 8 0 0 1 16 0"></path>
        <path d="M18 8h4"></path>
        <path d="m20 6 2 2-2 2"></path>
      </svg>
    </div>
    <div class="login-cta-content">
      <div data-login-logged-out>
        <div class="cta-title">{copy.loggedOutTitle}</div>
        <div class="cta-desc">
          {copy.loggedOutDescription}
          <ul class="cta-features">
            <li>{copy.askAi}</li>
            <li>{copy.editWithAi}</li>
          </ul>
        </div>
        <div class="cta-action">
          <a id="cta-login-btn" class="github-login-btn" href={loginUrl}>
            <svg height="20" width="20" viewBox="0 0 16 16" version="1.1" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span>{copy.login}</span>
          </a>
        </div>
      </div>
      <div data-login-logged-in hidden>
        <div class="cta-title">{copy.loggedInTitle}</div>
        <div class="cta-status">
          {copy.loggedInPrefix}{lang === 'en' && ' '}<span data-login-email></span>{' '}
          <button id="cta-logout-btn" class="cta-logout" type="button">{copy.logout}</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline type="module" src={loginCtaRuntimeUrl}></script>

<style>
  .login-cta-container {
    margin: 3rem auto;
    max-width: 600px;
    padding: 0 1rem;
  }

  .login-cta-card {
    --login-cta-copy: var(--color-text);

    border: 1px solid var(--color-border);
    border-radius: 12px;
    background-color: var(--color-surface);
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .login-cta-icon {
    display: inline-flex;
    color: var(--color-text-muted);
  }

  .login-cta-content {
    flex: 1;
  }

  .login-cta-content :global(.cta-title) {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--login-cta-copy);
  }

  .login-cta-content :global(.cta-desc) {
    font-size: 0.95rem;
    color: var(--login-cta-copy);
    margin-bottom: 1rem;
  }

  .login-cta-content :global(.cta-features) {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
  }

  .login-cta-content :global(.cta-features) :global(li) {
    margin-bottom: 0.25rem;
  }

  .login-cta-content :global(.cta-action) {
    margin-top: 1rem;
    text-align: center;
  }

  .login-cta-content :global(.github-login-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    background-color: var(--color-text);
    color: var(--color-bg);
    padding: 0 1.2rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      background-color 0.2s,
      transform 0.1s;
  }

  .login-cta-content :global(.github-login-btn:hover) {
    background-color: var(--color-text-muted);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .login-cta-content :global(.github-login-btn:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .login-cta-content :global(.cta-status) {
    color: var(--login-cta-copy);
    font-size: 0.9rem;
  }

  .login-cta-content :global(.cta-logout) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    color: var(--color-source-link);
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    padding: 0 0.5rem;
    margin-left: 0.25rem;
  }

  .login-cta-content :global(.cta-logout:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  :global([data-theme='light']) .login-cta-card {
    --login-cta-copy: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .login-cta-container {
      max-width: 100%;
    }
    .login-cta-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .login-cta-content :global(.cta-features) {
      text-align: left;
      display: inline-block;
    }
  }
</style>
