---
/**
 * PostTombstone — 下架文章的墓碑頁內容（openspec: post-takedown，design D4／D5）。
 *
 * 只渲染定稿內容：ticketId 與下架標籤、石碑、Mogu 對話框、去讀來源的卡片、
 * 回首頁連結，以及含文章標題的視覺隱藏 h1。文案全部來自
 * src/lib/tombstone-copy.mjs，這裡不寫任何字串。
 */
import type { CollectionEntry } from 'astro:content';
import TicketBadge from './TicketBadge.astro';
import tombstoneImage from '../assets/tombstone/tombstone.webp';
import moguCryingImage from '../assets/tombstone/mogu-crying.webp';
import { protectKaomoji } from '../plugins/remark-kaomoji-nowrap.mjs';
import {
  getSourceByline,
  getTombstoneCopy,
  getTombstoneHeading,
  getTombstoneStoneLines,
} from '../lib/tombstone-copy.mjs';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: 'zh-tw' | 'en';
}

const { post, lang } = Astro.props;
const { ticketId, title, translatedDate, takenDownAt, sourceTitle, sourceUrl, author } = post.data;

if (!takenDownAt || !sourceTitle?.trim()) {
  throw new Error(`${post.id}: taken-down post needs takenDownAt and sourceTitle`);
}

const copy = getTombstoneCopy({ ticketId, lang });
const [stoneOwner, stoneEpitaph, stoneDates, stoneRest] = getTombstoneStoneLines({
  ticketId,
  lang,
  translatedDate,
  takenDownAt,
});
const heading = getTombstoneHeading({ ticketId, lang, title });
const byline = getSourceByline({ author, sourceUrl });
---

<div class="tombstone" data-post-tombstone data-tombstone-series={copy.series} lang={lang}>
  <h1 class="tombstone-heading">{heading}</h1>

  <div class="tombstone-meta">
    <TicketBadge ticketId={ticketId} showTooltip={false} />
    <span class="tombstone-pill">{copy.pill}</span>
  </div>

  <div class="tombstone-scene">
    <div
      class="tombstone-stone"
      style={`aspect-ratio: ${tombstoneImage.width} / ${tombstoneImage.height}`}
    >
      <img src={tombstoneImage.src} alt="" decoding="async" />
      <p class="tombstone-inscription">
        <span class="tombstone-owner">{stoneOwner}</span>
        <span class="tombstone-epitaph">{stoneEpitaph}</span>
        <span class="tombstone-rule" aria-hidden="true"></span>
        <span class="tombstone-dates">{stoneDates}</span>
        <span class="tombstone-rest">{protectKaomoji(stoneRest)}</span>
      </p>
    </div>
    <img class="tombstone-mogu" src={moguCryingImage.src} alt="" decoding="async" />
  </div>

  <div class="tombstone-bubble">
    <strong>{copy.bubbleTitle}</strong>
    {copy.bubbleLines.map((line) => <p>{protectKaomoji(line)}</p>)}
  </div>

  <a class="tombstone-card" href={sourceUrl} target="_blank" rel="noopener noreferrer">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M14 4h6v6"></path>
      <path d="M20 4 11 13"></path>
      <path d="M19 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4"></path>
    </svg>
    <span class="tombstone-card-text">
      <span class="tombstone-card-label">{copy.cardLabel}</span>
      <span class="tombstone-card-title">{sourceTitle}</span>
      <span class="tombstone-card-byline">{byline}</span>
    </span>
  </a>

  <div class="tombstone-footer">
    <a href={copy.homeHref}>{copy.homeLabel}</a>
  </div>
</div>

<style>
  .tombstone {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.5rem 0 1rem;
  }

  /* 視覺隱藏、但讀螢幕與搜尋預覽讀得到的 h1。 */
  .tombstone-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .tombstone-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .tombstone-pill {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    border-radius: 999px;
    padding: 0.1rem 0.65rem;
    color: var(--color-mogu-orange);
    background: color-mix(in srgb, var(--color-mogu-orange) 14%, transparent);
  }

  /* 石碑與 Mogu 都是素材圖；碑文用 HTML 疊在石面上。石頭在兩個主題都是米色，
     所以碑文用兩個主題同值的深色墨水 token。 */
  .tombstone-scene {
    position: relative;
    height: 290px;
  }

  .tombstone-scene::after {
    content: '';
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: -8px;
    height: 16px;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--color-tombstone-ink) 18%, transparent),
      transparent 70%
    );
  }

  /* 石碑的大小由 aspect-ratio 決定，不靠圖片撐開；兩張圖都是裝飾、沒有 width／height
     屬性，載入失敗時什麼都不畫（不會出現破圖框）。 */
  .tombstone-stone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 225px;
    isolation: isolate;
  }

  /* 石碑圖載入前或載入失敗時的石頭色碑身：形狀貼著石碑圖的不透明範圍、再往內縮一點，
     圖載入後會被完全蓋住（實測 1x–3x 截圖逐像素相同）；碑文最寬的日期行也落在裡面，
     所以深淺主題的碑文都在同一個石頭色上。 */
  .tombstone-stone::before {
    content: '';
    position: absolute;
    inset: 3.5% 13.5% 26% 14.5%;
    z-index: -1;
    border-radius: 50% 50% 0 0 / 40% 40% 0 0;
    background: var(--color-tombstone-stone);
  }

  .tombstone-stone img {
    display: block;
    width: 100%;
    height: auto;
  }

  .tombstone-inscription {
    position: absolute;
    left: 16%;
    right: 22%;
    top: 21%;
    bottom: 29%;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    color: var(--color-tombstone-ink);
  }

  .tombstone-owner {
    font-size: 14px;
    font-weight: 700;
  }

  .tombstone-epitaph {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
  }

  .tombstone[lang='en'] .tombstone-epitaph {
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  .tombstone[lang='en'] .tombstone-rest {
    font-size: 13px;
  }

  .tombstone-rule {
    display: block;
    width: 80%;
    margin: 2px 0;
    border-top: 1px solid var(--color-tombstone-rule);
  }

  .tombstone-dates {
    font-size: 11px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tombstone-rest {
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  .tombstone-mogu {
    position: absolute;
    left: -4px;
    bottom: -4px;
    width: 150px;
    height: auto;
    z-index: 1;
  }

  .tombstone-bubble {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    color: var(--color-mogu-note-text);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .tombstone-bubble strong {
    color: var(--color-mogu-orange);
  }

  .tombstone-bubble p {
    margin: 0;
    text-wrap: pretty;
  }

  .tombstone-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 44px;
    padding: 0.875rem 1rem;
    border-radius: 12px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    text-decoration: none;
  }

  .tombstone-card:hover .tombstone-card-title,
  .tombstone-card:focus-visible .tombstone-card-title {
    text-decoration: underline;
  }

  .tombstone-card svg {
    flex: none;
    width: 30px;
    height: 30px;
  }

  .tombstone-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .tombstone-card-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .tombstone-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .tombstone-card-byline {
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .tombstone-footer {
    display: flex;
    justify-content: flex-end;
    font-size: 0.85rem;
  }

  .tombstone-footer a {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
