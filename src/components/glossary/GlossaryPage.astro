---
// 中英文詞彙表共用的頁面（openspec: glossary-browsing〈中英文詞彙表 SHALL 行為一致〉）。
// 兩頁只傳語言進來；語言差異只剩文字來源與文章連結。
import BaseLayout from '../../layouts/BaseLayout.astro';
import MoguNote from '../MoguNote.astro';
import '../../styles/glossary.css';
import glossaryData from '../../data/glossary.json';
import { getCollection } from 'astro:content';
import {
  glossaryCategoryFilters,
  glossaryCategoryLabel,
  parseGlossaryUrl,
  type GlossaryLang,
  type ParsedGlossaryUrl,
} from '../../config/glossary';
import { isPostTakenDown } from '../../utils/post-status';
import { glossaryAnchor, relatedGlossaryAnchor } from '../../lib/glossary-anchor.mjs';

interface Props {
  lang: GlossaryLang;
}

const { lang } = Astro.props;
const isEnglish = lang === 'en';

const copy = {
  'zh-tw': {
    title: '詞彙表 - gu-log',
    heading: '📖 詞彙表',
    intro: '本站常出現的 AI 術語。點術語展開完整說明。',
    // 複製按鈕要 JS 才有，這句由 script 加上按鈕時一起顯示。
    copyHint: '想分享某個詞條，按它右邊的按鈕複製連結。',
    searchPlaceholder: '搜尋術語...',
    searchLabel: '搜尋術語',
    all: '全部',
    categoryGroupLabel: '分類篩選',
    countSuffix: ' 個術語',
    alphabetLabel: '字母索引',
    // 詞條 meta 的標籤直接接內容：全形冒號後面不空格，英文標籤自己帶空格。
    threadLabel: 'Thread：',
    relatedLabel: '相關：',
    postsLabel: '文章：',
    copyLink: '複製「{term}」的連結',
    copiedLink: '已複製「{term}」的連結',
    listSeparator: '、',
    empty: '沒有符合的術語。',
    homeHref: '/',
    homeLabel: '← 返回首頁',
  },
  en: {
    title: 'Glossary - gu-log',
    heading: '📖 Glossary',
    intro: 'AI terms that show up often on gu-log. Tap a term to expand the full entry.',
    copyHint: ' To share one, use the button on its right to copy the link.',
    searchPlaceholder: 'Search terms...',
    searchLabel: 'Search terms',
    all: 'All',
    categoryGroupLabel: 'Category filter',
    countSuffix: ' terms',
    alphabetLabel: 'Alphabet index',
    threadLabel: 'Thread: ',
    relatedLabel: 'Related: ',
    postsLabel: 'Posts: ',
    copyLink: 'Copy link to {term}',
    copiedLink: 'Copied link to {term}',
    listSeparator: ', ',
    empty: 'No matching terms.',
    homeHref: '/en',
    homeLabel: '← Back home',
  },
}[lang];

// 詞條的「文章」連結指向這個語言的版本、顯示那一版的標題；已下架（openspec: post-takedown）
// 或沒有這個語言版本的文章不列。
const allPosts = await getCollection('posts');
const postsById = new Map(allPosts.map((post) => [post.id, post]));

function articleLinks(definedIn: { slug: string }[] | undefined) {
  return (definedIn ?? []).flatMap(({ slug }) => {
    const id = isEnglish ? `en-${slug}` : slug;
    const post = postsById.get(id);
    if (!post || isPostTakenDown(post, allPosts)) return [];
    return [{ href: isEnglish ? `/en/posts/${id}` : `/posts/${id}`, title: post.data.title }];
  });
}

const entries = [...glossaryData]
  .sort((a, b) => a.term.localeCompare(b.term))
  .map((item) => ({
    anchor: glossaryAnchor(item),
    term: item.term,
    en: item.en,
    aliases: item.aliases ?? [],
    category: item.category,
    categoryLabel: glossaryCategoryLabel(item.category, lang),
    definition: isEnglish ? (item.enDefinition ?? item.definition) : item.definition,
    moguNote: isEnglish ? item.enMoguNote : item.moguNote,
    safeUrl:
      item.url !== undefined
        ? parseGlossaryUrl(item.url, { allowInternal: true, field: `${item.term}.url` })
        : undefined,
    safeThreadUrl: item.thread
      ? parseGlossaryUrl(item.thread.url, {
          allowInternal: false,
          field: `${item.term}.thread.url`,
        })
      : undefined,
    threadTitle: (isEnglish ? item.thread?.enTitle : undefined) ?? item.thread?.title,
    related: (item.related ?? []).map((term) => ({
      term,
      anchor: relatedGlossaryAnchor(glossaryData, term),
    })),
    posts: articleLinks(item.definedIn),
  }));

// 清單項目之間插入分隔符號，例如 [A, B, C] → [A, '、', B, '、', C]。
function joinWith<T>(items: T[], separator: string): (T | string)[] {
  return items.flatMap((item, i) => (i === 0 ? [item] : [separator, item]));
}

function urlLabel(url: ParsedGlossaryUrl) {
  if (!url.external) return `gu-log${url.href}`;

  const u = new URL(url.href);
  const host = u.hostname.replace('www.', '');
  const parts = u.pathname.split('/').filter(Boolean);
  const skip = /^(en|zh|ja|ko|de|fr|es|pt|ru)$/i;
  const first = parts.find((p) => !skip.test(p));
  return first ? `${host}/${first}` : host;
}

const categories = [{ id: 'all', label: copy.all }, ...glossaryCategoryFilters(entries, lang)];

const groups: { letter: string; items: typeof entries }[] = [];
for (const item of entries) {
  const letter = item.term[0].toUpperCase();
  const current = groups.at(-1);
  if (current?.letter === letter) {
    current.items.push(item);
  } else {
    groups.push({ letter, items: [item] });
  }
}
---

<BaseLayout title={copy.title} lang={lang}>
  <article class="glossary-page">
    <header>
      <h1>{copy.heading}</h1>
      <p class="glossary-intro">
        {copy.intro}<span class="glossary-copy-hint" hidden>{copy.copyHint}</span>
      </p>
    </header>

    {/* 搜尋、分類按鈕與 A–Z 列捲動時固定在上方（openspec: glossary-browsing）。 */}
    <div class="glossary-toolbar" id="glossary-toolbar">
      <div class="toolbar-search">
        <input
          type="search"
          id="glossary-search"
          class="glossary-search"
          placeholder={copy.searchPlaceholder}
          aria-label={copy.searchLabel}
        />
        <span
          class="glossary-count"
          id="glossary-count"
          data-count-suffix={copy.countSuffix}
          aria-live="polite"
        >
          {entries.length}{copy.countSuffix}
        </span>
      </div>
      <div class="category-pills" role="group" aria-label={copy.categoryGroupLabel}>
        {
          categories.map((cat) => (
            <button
              type="button"
              class="category-pill"
              data-category={cat.id}
              aria-pressed={cat.id === 'all' ? 'true' : 'false'}
            >
              {cat.label}
            </button>
          ))
        }
      </div>
      <nav class="alpha-bar" aria-label={copy.alphabetLabel}>
        {
          groups.map(({ letter }) => (
            <a href={`#letter-${letter}`} class="alpha-link">
              {letter}
            </a>
          ))
        }
      </nav>
    </div>

    <div id="glossary-list">
      {
        groups.map((group) => (
          <section class="letter-section" data-letter={group.letter} id={`letter-${group.letter}`}>
            <h2 class="letter-heading">{group.letter}</h2>
            <dl class="section-list">
              {group.items.map((item) => (
                <div
                  class="glossary-entry"
                  id={item.anchor}
                  data-category={item.category}
                  data-search={[item.term, item.en, ...item.aliases].join(' ').toLowerCase()}
                >
                  <dt class="entry-head">
                    {/* 沒有 JS 時是指向自己錨點的連結（:target 展開）；有 JS 時換成切換按鈕。 */}
                    <a href={`#${item.anchor}`} class="entry-toggle">
                      <span class="term-name">{item.term}</span>
                      {item.en !== item.term && <span class="term-en">{item.en}</span>}
                      <span class={`term-cat cat-${item.category}`}>{item.categoryLabel}</span>
                    </a>
                  </dt>
                  <dd>
                    <p class="term-def">{item.definition}</p>
                    <div class="entry-details" id={`${item.anchor}__details`}>
                      {item.moguNote && <MoguNote>{item.moguNote}</MoguNote>}
                      {item.safeUrl && (
                        <p class="term-meta">
                          <a
                            href={item.safeUrl.href}
                            target={item.safeUrl.external ? '_blank' : undefined}
                            rel={item.safeUrl.external ? 'noopener noreferrer' : undefined}
                          >
                            {urlLabel(item.safeUrl)}
                            {item.safeUrl.external && ' ↗'}
                          </a>
                        </p>
                      )}
                      {/* 標籤、分隔符號與連結寫在同一個運算式裡，模板的換行才不會變成「A 、 B」這種多餘空白。 */}
                      {item.safeThreadUrl && (
                        <p class="term-meta">
                          {[
                            copy.threadLabel,
                            <a
                              href={item.safeThreadUrl.href}
                              target="_blank"
                              rel="noopener noreferrer"
                            >{`${item.threadTitle ?? urlLabel(item.safeThreadUrl)} ↗`}</a>,
                          ]}
                        </p>
                      )}
                      {item.related.length > 0 && (
                        <p class="term-meta">
                          {[
                            copy.relatedLabel,
                            ...joinWith(
                              item.related.map((rel) => <a href={`#${rel.anchor}`}>{rel.term}</a>),
                              copy.listSeparator
                            ),
                          ]}
                        </p>
                      )}
                      {item.posts.length > 0 && (
                        <p class="term-meta">
                          {[
                            copy.postsLabel,
                            ...joinWith(
                              item.posts.map((post) => <a href={post.href}>{post.title}</a>),
                              copy.listSeparator
                            ),
                          ]}
                        </p>
                      )}
                    </div>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>

    <p class="glossary-empty" id="glossary-empty" hidden>{copy.empty}</p>
    <p
      class="visually-hidden"
      id="glossary-status"
      role="status"
      data-copy-link={copy.copyLink}
      data-copied-link={copy.copiedLink}
    >
    </p>

    {/* 複製連結要靠 JS，所以按鈕由 script 從這個 template 複製到每一列。 */}
    <template id="glossary-copy-button">
      <button type="button" class="entry-copy">
        <svg class="icon-link" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
        <svg class="icon-check" viewBox="0 0 24 24" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </button>
    </template>

    <footer class="glossary-footer">
      <a href={copy.homeHref}>{copy.homeLabel}</a>
    </footer>
  </article>
</BaseLayout>

<script>
  import './glossary-client';
</script>
