---
/**
 * Mermaid diagram component
 * - Renders Mermaid diagrams client-side
 * - Scrollable horizontally on mobile
 * - Tap to expand fullscreen (pinch-to-zoom friendly)
 *
 * Usage in MDX:
 *   <Mermaid chart={`graph TB\n  A-->B`} caption="My diagram" />
 */
interface Props {
  /** Mermaid diagram definition (pass as template literal) */
  chart: string;
  /** Optional caption below the diagram */
  caption?: string;
}

const { chart, caption } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith('/en/');
const expandLabel = isEnglish ? 'Expand diagram' : '展開圖表';
const expandTitle = isEnglish ? 'Click to enlarge' : '點擊放大';
const closeLabel = isEnglish ? 'Close diagram' : '關閉圖表';
const loadingLabel = isEnglish ? 'Loading diagram...' : '載入圖表中...';
---

<div class="mermaid-wrapper" data-markdown-adapter="mermaid">
  <div class="mermaid-scroll">
    <div class="mermaid-source" style="display:none;" data-mermaid>{chart}</div>
    <div class="mermaid-render" data-loading-label={loadingLabel}></div>
  </div>
  {caption && <p class="mermaid-caption">{caption}</p>}
  <button class="mermaid-expand-btn" aria-label={expandLabel} title={expandTitle}>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
    </svg>
  </button>
</div>

<!-- Fullscreen overlay (one per diagram, activated by JS) -->
<div class="mermaid-overlay" style="display:none;">
  <button class="mermaid-close-btn" aria-label={closeLabel}>✕</button>
  <div class="mermaid-overlay-content"></div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC&display=swap');

  @font-face {
    font-family: 'Virgil';
    src: url('https://excalidraw.com/Virgil.woff2') format('woff2');
    font-display: swap;
  }

  .mermaid-wrapper {
    position: relative;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-bg-muted);
  }

  .mermaid-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    padding: 1rem;
    min-height: 100px;
    display: flex;
    justify-content: center;
  }

  .mermaid-render {
    min-width: fit-content;
  }

  .mermaid-render :global(svg) {
    max-width: none;
    height: auto;
  }

  .mermaid-caption {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    padding: 0.5rem 1rem 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .mermaid-expand-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 4px 6px;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s;
    color: var(--color-text);
    z-index: 1;
  }

  .mermaid-expand-btn:hover {
    opacity: 1;
  }

  /* Fullscreen overlay */
  .mermaid-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y pinch-zoom;
  }

  .mermaid-overlay-content {
    padding: 2rem;
    max-width: 95vw;
    max-height: 95vh;
    overflow: auto;
  }

  .mermaid-overlay-content :global(svg) {
    max-width: none;
    height: auto;
  }

  .mermaid-close-btn {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 10000;
    background: var(--color-panel-subtle);
    border: none;
    color: var(--color-text);
    font-size: 1.5rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid-close-btn:hover {
    background: var(--color-divider);
  }

  /* Loading state */
  .mermaid-render:empty::after {
    content: attr(data-loading-label);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>

<script>
  function readThemeColor(styles: CSSStyleDeclaration, name: string) {
    return styles.getPropertyValue(name).trim();
  }

  // Initialize all Mermaid diagrams on page load
  async function initMermaidDiagrams() {
    const mermaidUrl = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    const { default: mermaid } = await import(/* @vite-ignore */ mermaidUrl);
    const themeStyles = getComputedStyle(document.documentElement);

    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      look: 'handDrawn',
      themeVariables: {
        primaryColor: readThemeColor(themeStyles, '--color-surface'),
        primaryTextColor: readThemeColor(themeStyles, '--color-surface-meta'),
        primaryBorderColor: readThemeColor(themeStyles, '--color-border'),
        lineColor: readThemeColor(themeStyles, '--color-text-muted'),
        secondaryColor: readThemeColor(themeStyles, '--color-surface-hover'),
        tertiaryColor: readThemeColor(themeStyles, '--color-bg-muted'),
        noteTextColor: readThemeColor(themeStyles, '--color-surface-meta'),
        noteBkgColor: readThemeColor(themeStyles, '--color-surface'),
        fontFamily: '"Virgil", "LXGW WenKai TC", cursive, system-ui',
      },
      flowchart: { htmlLabels: true, curve: 'basis' },
      securityLevel: 'strict',
    });

    const wrappers = document.querySelectorAll('.mermaid-wrapper');

    // Collect all Chinese chars from diagrams to force-trigger font loading
    const allDefs: string[] = [];
    for (const w of wrappers) {
      const s = w.querySelector('.mermaid-source');
      if (s) allDefs.push(s.textContent || '');
    }
    const cjkChars = allDefs.join('').replace(/[^\u4e00-\u9fff\u3400-\u4dbf]/g, '');

    // Force browser to request the CJK font subsets by rendering chars in a hidden element
    if (cjkChars) {
      const probe = document.createElement('span');
      probe.style.cssText =
        'font-family:"LXGW WenKai TC",cursive;position:absolute;left:-9999px;visibility:hidden;font-size:16px';
      probe.textContent = cjkChars;
      document.body.appendChild(probe);
      // Also probe Virgil for Latin
      const probeV = document.createElement('span');
      probeV.style.cssText =
        'font-family:"Virgil",cursive;position:absolute;left:-9999px;visibility:hidden;font-size:16px';
      probeV.textContent = 'ABCabc123';
      document.body.appendChild(probeV);
      // Wait for all fonts to finish loading
      await document.fonts.ready;
      probe.remove();
      probeV.remove();
    }

    for (const wrapper of wrappers) {
      const source = wrapper.querySelector('.mermaid-source');
      const renderTarget = wrapper.querySelector('.mermaid-render');
      const expandBtn = wrapper.querySelector('.mermaid-expand-btn');
      const overlay = wrapper.nextElementSibling;

      if (!source || !renderTarget) continue;

      const def = source.textContent?.trim() || '';
      const id = `mermaid-${Math.random().toString(36).slice(2, 9)}`;

      try {
        const { svg } = await mermaid.render(id, def);
        renderTarget.innerHTML = svg;
      } catch (e) {
        renderTarget.innerHTML = `<pre style="color:var(--color-status-danger);font-size:0.8rem;">Mermaid error: ${e}</pre>`;
        continue;
      }

      // Expand button
      if (expandBtn && overlay) {
        const overlayContent = overlay.querySelector('.mermaid-overlay-content');
        const closeBtn = overlay.querySelector('.mermaid-close-btn');

        (expandBtn as HTMLElement).onclick = () => {
          if (overlayContent) {
            overlayContent.innerHTML = renderTarget.innerHTML;
          }
          (overlay as HTMLElement).style.display = 'flex';
          document.body.style.overflow = 'hidden';
        };

        const closeOverlay = () => {
          (overlay as HTMLElement).style.display = 'none';
          document.body.style.overflow = '';
        };

        if (closeBtn) {
          (closeBtn as HTMLElement).onclick = closeOverlay;
        }
        (overlay as HTMLElement).onclick = (e) => {
          if (e.target === overlay) closeOverlay();
        };
      }
    }
  }

  // Run on page load and on Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMermaidDiagrams);
  } else {
    initMermaidDiagrams();
  }
  document.addEventListener('astro:page-load', initMermaidDiagrams);

  new MutationObserver((mutations) => {
    if (mutations.some((mutation) => mutation.attributeName === 'data-theme')) {
      initMermaidDiagrams();
    }
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
