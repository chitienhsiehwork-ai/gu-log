---
// Client-side script to add copy buttons to all code blocks
---

<script>
  function addCopyButtons() {
    const codeBlocks = document.querySelectorAll('pre');

    codeBlocks.forEach((pre) => {
      // Skip code blocks already wrapped by this initializer.
      if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

      // Create wrapper
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      // Wrap the pre element
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      // Create copy button
      const button = document.createElement('button');
      button.className = 'copy-button';
      button.setAttribute('aria-label', 'Copy code');
      button.innerHTML = `
        <span class="copy-icons" aria-hidden="true">
          <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        <span class="copy-text">Copy</span>
      `;

      // Screen readers get the result here; the button's aria-label stays stable.
      const status = document.createElement('span');
      status.className = 'copy-status';
      status.setAttribute('aria-live', 'polite');

      let copyResetTimer: ReturnType<typeof setTimeout> | undefined;
      const textSpan = button.querySelector('.copy-text');

      const setState = (state: 'copied' | 'failed' | '', label: string, announce: string) => {
        button.classList.remove('copied', 'failed');
        if (state) button.classList.add(state);
        if (textSpan) textSpan.textContent = label;
        status.textContent = announce;
      };

      // Only the latest click may write state, so a slow earlier clipboard
      // promise can't overwrite it or schedule an early reset.
      let copyRequest = 0;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent || pre.textContent || '';
        const request = ++copyRequest;
        let ok = true;

        try {
          await navigator.clipboard.writeText(code);
        } catch {
          ok = false;
        }
        if (request !== copyRequest) return;

        clearTimeout(copyResetTimer);
        if (ok) setState('copied', 'Copied!', 'Code copied to clipboard');
        else
          setState('failed', 'Copy failed', 'Copy failed. Select the code and copy it manually.');
        copyResetTimer = setTimeout(() => setState('', 'Copy', ''), 2000);
      });

      wrapper.append(button, status);
    });
  }

  // Run on page load
  addCopyButtons();

  // Re-run on navigation (for SPAs)
  document.addEventListener('astro:page-load', addCopyButtons);
</script>

<style is:global>
  .code-block-wrapper {
    position: relative;
    margin: var(--spacing-sm) 0;
  }

  .copy-button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-code-copy-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-code-copy-text);
    font-size: 0.75rem;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: all 0.2s ease;
    opacity: 0;
  }

  .code-block-wrapper:hover .copy-button {
    opacity: 1;
  }

  .copy-button:focus-visible {
    opacity: 1;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .copy-button:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .copy-button.copied {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .copy-button.failed {
    background: var(--color-bg);
    color: var(--color-status-danger);
    border-color: var(--color-status-danger);
  }

  .copy-button.copied,
  .copy-button.failed {
    opacity: 1;
  }

  /* Copy and check icons share one slot so the swap never shifts layout. */
  .copy-icons {
    display: grid;
    width: 14px;
    height: 14px;
  }

  .copy-icons svg {
    grid-area: 1 / 1;
    width: 14px;
    height: 14px;
    transition:
      opacity 160ms ease-out,
      transform 160ms ease-out;
  }

  .copy-button .icon-check,
  .copy-button.copied .icon-copy {
    opacity: 0;
    transform: scale(0.6);
  }

  .copy-button.copied .icon-check {
    opacity: 1;
    transform: none;
  }

  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-button,
    .copy-icons svg {
      transition: none;
    }
  }

  /* Always show on mobile/touch devices */
  @media (hover: none) {
    .copy-button {
      opacity: 1;
    }
  }
</style>
