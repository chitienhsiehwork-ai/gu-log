---
/**
 * AiPopup Component
 *
 * Text selection popup for AI interactions (Ask AI / Edit with AI).
 * Triggers on text selection within .post-content areas.
 * Supports dark/light themes, desktop floating + mobile bottom sheet.
 */

interface Props {
  filePath?: string;
  postTitle?: string;
  lang?: 'zh-tw' | 'en';
}

const { filePath = '', postTitle = '', lang = 'zh-tw' } = Astro.props;

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.shroomdog.dev';
---

<div
  id="ai-popup-root"
  data-file-path={filePath}
  data-post-title={postTitle}
  data-api-url={apiUrl}
  data-lang={lang}
>
  <!-- Popup is created dynamically by JS -->
</div>

<script src="./ai-popup-client.js"></script>

<style is:global>
  /* ─── AI Popup Base ─── */
  .ai-popup {
    position: absolute;
    z-index: 9999;
    background: var(--color-surface, #24283b);
    border: 1px solid rgba(122, 162, 247, 0.25);
    border-radius: 10px;
    padding: 0.4rem;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(122, 162, 247, 0.1);
    display: flex;
    gap: 0.25rem;
    animation: ai-popup-fadein 0.15s ease-out;
    max-width: 90vw;
    backdrop-filter: blur(12px);
  }

  @keyframes ai-popup-fadein {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Desktop floating (buttons only) ─── */
  .ai-popup--desktop {
    position: absolute;
  }

  /* ─── Desktop sidebar (panels) — fixed right, doesn't block content ─── */
  .ai-popup--sidebar {
    position: fixed;
    top: 5rem;
    right: 1rem;
    left: auto;
    max-width: min(400px, 35vw);
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    flex-direction: column;
  }

  /* ─── Mobile Bottom Sheet ─── */
  .ai-popup--mobile {
    position: fixed;
    bottom: max(0.5rem, env(safe-area-inset-bottom));
    left: 0.5rem;
    right: 0.5rem;
    top: auto;
    border-radius: 16px;
    padding: 0.75rem 0.75rem calc(0.85rem + env(safe-area-inset-bottom));
    max-width: none;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.4);
    animation: ai-popup-slideup 0.2s ease-out;
    max-height: min(72dvh, calc(100vh - 1rem));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @keyframes ai-popup-slideup {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  /* ─── Buttons ─── */
  .ai-popup-btn {
    border: none;
    background: transparent;
    color: var(--color-text, #a9b1d6);
    font-size: 0.85rem;
    padding: 0.55rem 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    font-family: inherit;
    transition:
      background 0.15s,
      transform 0.15s;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ai-popup-btn:hover {
    background: var(--color-surface-hover, #2f3549);
  }

  .ai-popup-btn:active {
    transform: scale(0.98);
  }

  .ai-popup-btn:disabled,
  .ai-popup-btn[aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
  }

  .ai-popup-btn--login {
    color: var(--color-accent, #7aa2f7);
    font-weight: 500;
  }

  .ai-popup-btn--ask {
    color: var(--color-accent, #7aa2f7);
  }

  .ai-popup-btn--edit {
    color: #9ece6a;
  }

  /* ─── Primary / Ghost button hierarchy ─── */
  .ai-popup-btn--primary {
    background: rgba(158, 206, 106, 0.15);
    color: #9ece6a;
    font-weight: 600;
    border: 1px solid rgba(158, 206, 106, 0.3);
  }

  .ai-popup-btn--primary:hover {
    background: rgba(158, 206, 106, 0.25);
  }

  .ai-popup-btn--ghost {
    background: transparent;
    color: var(--color-text-muted, #565f89);
    font-weight: 400;
  }

  .ai-popup-btn--ghost:hover {
    background: var(--color-surface-hover, #2f3549);
    color: var(--color-text, #a9b1d6);
  }

  /* ─── Ask Input ─── */
  .ai-popup-ask-input-container {
    padding: 0.5rem;
    min-width: 280px;
    max-width: min(500px, 90vw);
  }

  .ai-popup-panel-header {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-right: 2rem;
  }

  .ai-popup-title {
    font-size: 0.95rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--color-text, #a9b1d6);
  }

  .ai-popup-subtitle {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-text-muted, #565f89);
  }

  .ai-popup-selection {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    border: 1px solid rgba(122, 162, 247, 0.18);
    background: rgba(122, 162, 247, 0.08);
  }

  .ai-popup-selection-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted, #565f89);
  }

  .ai-popup-selection-text {
    margin-top: 0.3rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text, #a9b1d6);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .ai-popup-question-input,
  .ai-popup-edit-input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border, #3b4261);
    border-radius: 6px;
    background: var(--color-bg, #1a1b26);
    color: var(--color-text, #a9b1d6);
    font-size: 0.85rem;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
  }

  .ai-popup-question-input:focus,
  .ai-popup-edit-input:focus {
    border-color: var(--color-accent, #7aa2f7);
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.2);
  }

  .ai-popup-question-input::placeholder,
  .ai-popup-edit-input::placeholder {
    color: var(--color-text-muted, #565f89);
    opacity: 0.7;
  }

  /* ─── Loading ─── */
  .ai-popup-loading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    color: var(--color-text-muted, #565f89);
    font-size: 0.85rem;
    min-width: 220px;
  }

  .ai-popup-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-border, #3b4261);
    border-top-color: var(--color-accent, #7aa2f7);
    border-radius: 50%;
    animation: ai-spin 0.7s linear infinite;
    flex-shrink: 0;
  }

  @keyframes ai-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ─── Result Panel ─── */
  .ai-popup-result {
    position: relative;
    padding: 0.5rem;
    min-width: 280px;
    max-width: min(500px, 90vw);
    max-height: 60vh;
    overflow-y: auto;
  }

  .ai-popup-close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    background: transparent;
    border: none;
    color: var(--color-text-muted, #565f89);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 4px;
    line-height: 1;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-popup-close:hover {
    background: var(--color-surface-hover, #2f3549);
    color: var(--color-text, #a9b1d6);
  }

  .ai-popup-result-body {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text, #a9b1d6);
    word-break: break-word;
  }

  .ai-popup-result-body p {
    margin: 0 0 0.75rem 0;
  }

  .ai-popup-result-body p:last-child {
    margin-bottom: 0;
  }

  .ai-popup-result-body strong {
    font-weight: 600;
    color: var(--color-accent, #7aa2f7);
  }

  .ai-popup-result-body code {
    font-family: var(--font-mono, monospace);
    background: rgba(122, 162, 247, 0.1);
    padding: 0.15em 0.3em;
    border-radius: 4px;
    font-size: 0.85em;
  }

  .ai-popup-result-body pre code {
    display: block;
    padding: 0.5rem;
    overflow-x: auto;
    background: var(--color-bg, #1a1b26);
  }

  .ai-popup-result-body ul,
  .ai-popup-result-body ol {
    margin: 0 0 0.75rem 1.5rem;
    padding: 0;
  }

  .ai-popup-result--error .ai-popup-error-text {
    margin-top: 0.75rem;
    color: #f7768e;
    font-size: 0.85rem;
  }

  .ai-popup-result--auth-error .ai-popup-error-text {
    color: var(--color-status-warning);
  }

  .ai-popup-result--auth-error .ai-popup-title {
    color: var(--color-status-warning);
  }

  .ai-popup-result--auth-error {
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-status-warning) 8%, transparent);
  }

  .ai-popup-result--auth-error .ai-popup-btn--primary {
    border-color: var(--color-status-warning);
    background: var(--color-status-warning);
    color: var(--color-bg);
  }

  .ai-popup-result--auth-error .ai-popup-btn--primary:hover {
    background: color-mix(in srgb, var(--color-status-warning) 85%, var(--color-text));
  }

  :root:not([data-theme='light']) .ai-popup-result--auth-error .ai-popup-btn--ghost {
    color: var(--color-text);
  }

  /* ─── Diff Display ─── */
  .ai-popup-diff {
    margin-top: 0.75rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    line-height: 1.5;
    background: var(--color-bg, #1a1b26);
    border-radius: 6px;
    padding: 0.5rem;
    overflow-x: auto;
    max-height: 40vh;
    overflow-y: auto;
  }

  .ai-popup-diff-line {
    white-space: pre;
    padding: 0 0.5rem;
  }

  .ai-popup-diff-add {
    background: rgba(158, 206, 106, 0.15);
    color: #9ece6a;
  }

  .ai-popup-diff-remove {
    background: rgba(247, 118, 142, 0.15);
    color: #f7768e;
  }

  .ai-popup-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border, #3b4261);
    flex-wrap: wrap;
  }

  /* ─── Committed ─── */
  .ai-popup-committed {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: #9ece6a;
  }

  .ai-popup-committed code {
    font-family: var(--font-mono, monospace);
    background: var(--color-bg, #1a1b26);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.85em;
  }

  .ai-popup-committed-icon {
    font-size: 1.1em;
  }

  /* ─── Scope Indicator ─── */
  .ai-popup-scope {
    font-size: 0.72rem;
    color: var(--color-text-muted, #565f89);
    padding: 0.3rem 0.5rem;
    background: rgba(122, 162, 247, 0.06);
    border-radius: 4px;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  /* ─── Undo Hint ─── */
  .ai-popup-undo-hint {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted, #565f89);
    font-style: italic;
  }

  /* ─── Textarea for edit input ─── */
  .ai-popup-edit-input {
    resize: vertical;
    min-height: 60px;
  }

  /* ─── Light Theme Overrides ─── */
  [data-theme='light'] .ai-popup {
    border-color: rgba(38, 139, 121, 0.25);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.12),
      0 0 0 1px rgba(38, 139, 121, 0.1);
  }

  [data-theme='light'] .ai-popup-btn--primary {
    background: rgba(38, 139, 121, 0.1);
    color: var(--color-badge-sd);
    border-color: rgba(38, 139, 121, 0.25);
  }

  [data-theme='light'] .ai-popup-btn--primary:hover {
    background: rgba(38, 139, 121, 0.18);
  }

  [data-theme='light'] .ai-popup-selection {
    background: rgba(38, 139, 121, 0.08);
    border-color: rgba(38, 139, 121, 0.18);
  }

  [data-theme='light'] .ai-popup-btn--edit {
    color: var(--color-badge-sd);
  }

  [data-theme='light'] .ai-popup-diff-add {
    background: rgba(38, 139, 121, 0.1);
    color: var(--color-badge-sd);
  }

  [data-theme='light'] .ai-popup-diff-remove {
    background: rgba(220, 50, 47, 0.1);
    color: #dc322f;
  }

  [data-theme='light'] .ai-popup-committed {
    color: var(--color-badge-sd);
  }

  [data-theme='light'] .ai-popup-result--error .ai-popup-error-text {
    color: #dc322f;
  }

  [data-theme='light'] .ai-popup-result--auth-error .ai-popup-error-text {
    color: var(--color-status-warning);
  }

  [data-theme='light'] .ai-popup-result--auth-error .ai-popup-btn--primary {
    border-color: var(--color-status-warning);
    background: var(--color-status-warning);
    color: var(--color-bg);
  }

  [data-theme='light'] .ai-popup-result--auth-error .ai-popup-btn--primary:hover {
    background: color-mix(in srgb, var(--color-status-warning) 85%, var(--color-text));
  }

  [data-theme='light'] .ai-popup-question-input:focus,
  [data-theme='light'] .ai-popup-edit-input:focus {
    border-color: var(--color-accent, #1c679b);
    box-shadow: 0 0 0 2px rgba(38, 139, 121, 0.2);
  }

  [data-theme='light'] .ai-popup-scope {
    background: rgba(38, 139, 121, 0.06);
  }

  /* ─── Mobile adjustments ─── */
  @media (max-width: 639px) {
    .ai-popup {
      gap: 0.5rem;
    }

    .ai-popup-btn {
      flex: 1 1 calc(50% - 0.25rem);
    }

    .ai-popup-ask-input-container,
    .ai-popup-result {
      min-width: unset;
      max-width: 100%;
      max-height: none;
    }

    .ai-popup-loading {
      min-width: 0;
    }

    .ai-popup-actions .ai-popup-btn {
      flex: 1 1 0;
    }
  }
</style>
