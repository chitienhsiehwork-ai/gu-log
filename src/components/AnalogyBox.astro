---
/**
 * AnalogyBox - Visual callout for analogies / metaphors
 *
 * Usage in .mdx:
 *   <AnalogyBox title="🏢 辦公室大樓的比喻">
 *     DNS 就像大樓的總機小姐…
 *   </AnalogyBox>
 */

interface Props {
  title?: string;
}

const isEnglish = Astro.url.pathname.startsWith('/en/');
const { title = isEnglish ? '💡 Analogy time' : '💡 類比時間' } = Astro.props;
const badgeLabel = isEnglish ? 'Analogy' : '類比';
---

<aside class="analogy-box" role="note" data-markdown-adapter="analogy-box">
  <div class="analogy-header">
    <span class="analogy-title">{title}</span>
    <span class="analogy-badge">{badgeLabel}</span>
  </div>
  <div class="analogy-content">
    <slot />
  </div>
</aside>

<style>
  .analogy-box {
    border: 2px solid var(--color-analogy-accent);
    border-radius: 12px;
    padding: 1.25rem;
    margin: 1.5rem 0;
    background: color-mix(in srgb, var(--color-analogy-accent) 6%, transparent);
    position: relative;
  }

  .analogy-header {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .analogy-title {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  .analogy-badge {
    flex-shrink: 0;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-analogy-accent) 15%, transparent);
    color: var(--color-analogy-accent);
    font-weight: 600;
  }

  .analogy-content {
    color: var(--color-text);
    line-height: 1.7;
  }

  .analogy-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
