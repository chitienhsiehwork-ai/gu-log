---
interface Props {
  currentLang: 'zh-tw' | 'en';
  /** Resolved by BaseLayout; see its `alternateHref` prop. */
  href: string;
}

const { currentLang, href } = Astro.props;
const switchLabel = currentLang === 'zh-tw' ? '切換至英文' : 'Switch to Chinese';
---

<a href={href} class="icon-btn" title={switchLabel} aria-label={switchLabel}>
  <svg
    class="nav-svg-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M2 12h20"></path>
    <path
      d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
    ></path>
  </svg>
</a>

<!-- Uses global .icon-btn and .nav-svg-icon styles from BaseLayout -->
