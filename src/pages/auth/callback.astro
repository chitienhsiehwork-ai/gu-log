---
/**
 * OAuth Callback Page
 *
 * After GitHub OAuth, the backend redirects here with a token.
 * Prefers hash fragment (#token=xxx) with query param fallback for compatibility.
 * Stores the JWT in localStorage and redirects back to the original page.
 */
import '../../styles/global.css';

const configuredApiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.shroomdog.dev';
const parsedApiUrl = new URL(configuredApiUrl);

if (parsedApiUrl.protocol !== 'https:' && parsedApiUrl.protocol !== 'http:') {
  throw new Error('PUBLIC_API_URL must use http or https');
}

const apiUrl = parsedApiUrl.href.replace(/\/$/, '');
const loginUrl = `${apiUrl}/auth/github`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logging in...</title>
    <script is:inline>
      let theme = 'dark';
      try {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') theme = savedTheme;
      } catch {
        // Storage can be unavailable; dark is the safe first-paint fallback.
      }
      document.documentElement.setAttribute('data-theme', theme);
    </script>
    <style>
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
        background: var(--color-bg);
        color: var(--color-text);
      }
      .callback-container {
        text-align: center;
        padding: 2rem;
      }
      .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid var(--color-border);
        border-top-color: var(--color-status-info);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 1rem;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .error {
        color: var(--color-status-danger);
        margin-top: 1rem;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem 1rem;
        margin-top: 1.5rem;
      }
      .actions a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding-inline: 0.75rem;
        color: var(--color-accent);
        font-weight: 600;
      }
      .actions a:focus-visible {
        outline: 2px solid var(--color-status-info);
        outline-offset: 3px;
        border-radius: 0.25rem;
      }
      [hidden] {
        display: none !important;
      }
      @media (prefers-reduced-motion: reduce) {
        .spinner {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="callback-container">
      <div class="callback-status" role="status" aria-live="polite" aria-atomic="true">
        <div class="spinner" aria-hidden="true"></div>
        <p id="status">Logging in...</p>
        <p id="error" class="error" hidden></p>
      </div>
      <div id="actions" class="actions" hidden>
        <a href={loginUrl}>Try GitHub login again</a>
        <a href="/">Back to homepage</a>
      </div>
    </div>

    <script is:inline>
      (function () {
        const JWT_KEY = 'gu-log-jwt';
        const RETURN_KEY = 'gu-log-return-url';

        function getSafeReturnUrl(rawReturnUrl) {
          const fallbackUrl = `${window.location.origin}/`;
          if (!rawReturnUrl) return fallbackUrl;

          try {
            const parsed = new URL(rawReturnUrl, window.location.origin);
            if (
              (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') ||
              parsed.origin !== window.location.origin ||
              parsed.pathname.startsWith('//')
            ) {
              return fallbackUrl;
            }
            return `${window.location.origin}${parsed.pathname}${parsed.search}${parsed.hash}`;
          } catch {
            return fallbackUrl;
          }
        }

        function showFailure(message) {
          document.getElementById('status').textContent = 'Login failed.';
          document.querySelector('.spinner').hidden = true;
          document.title = 'Login failed';
          const errorEl = document.getElementById('error');
          errorEl.hidden = false;
          errorEl.textContent = message;
          document.getElementById('actions').hidden = false;
        }

        let token = null;
        if (window.location.hash) {
          const hashParams = new URLSearchParams(window.location.hash.substring(1));
          token = hashParams.get('token');
        }

        if (!token) {
          const params = new URLSearchParams(window.location.search);
          token = params.get('token');
        }

        if (token) {
          window.history.replaceState(window.history.state, '', window.location.pathname);
          try {
            localStorage.setItem(JWT_KEY, token);
          } catch {
            try {
              localStorage.removeItem(JWT_KEY);
            } catch {
              // Storage is fully unavailable; the error UI must remain terminal.
            }
            showFailure(
              'Your login token could not be saved because site storage is unavailable. Enable site storage and try again.'
            );
            return;
          }
          document.getElementById('status').textContent = 'Login successful! Redirecting...';
          document.querySelector('.spinner').hidden = true;
          document.title = 'Login successful';

          // Redirect back to the page user was on
          let returnUrl = null;
          try {
            returnUrl = localStorage.getItem(RETURN_KEY);
            localStorage.removeItem(RETURN_KEY);
          } catch {
            // Authentication succeeded; fall back home when return storage is unavailable.
            returnUrl = null;
          }
          const safeReturnUrl = getSafeReturnUrl(returnUrl);

          setTimeout(function () {
            window.location.replace(safeReturnUrl);
          }, 500);
        } else {
          showFailure('No token received. Choose an option below.');
        }
      })();
    </script>
  </body>
</html>
