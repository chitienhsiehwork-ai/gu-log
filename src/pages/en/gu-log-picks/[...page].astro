---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TicketBadge from '../../../components/TicketBadge.astro';
import Toggle from '../../../components/Toggle.astro';
import PostStatusLabel from '../../../components/PostStatusLabel.astro';
import Pagination from '../../../components/Pagination.astro';
import { getListablePosts, getPostStatus } from '../../../utils/post-status';
import type { PostStatus } from '../../../utils/post-status';
import { GP_SERIES_PAUSED, getGpPausedNotice } from '../../../lib/gp-series-pause.mjs';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const getTicketNumber = (ticketId: string | undefined) => {
    if (!ticketId) return 0;
    const match = ticketId.match(/\d+$/);
    return match ? parseInt(match[0]) : 0;
  };
  const allPostsFull = await getCollection('posts');
  // GP 暫停收文期間（editorial-charter、post-takedown design D6）不列任何文章，
  // 只產生第 1 頁的改版空狀態；GP-1 示範文照舊可用網址、RSS 與搜尋讀到。
  const gpPosts = GP_SERIES_PAUSED
    ? []
    : getListablePosts(allPostsFull, 'en')
        .filter((post) => post.data.ticketId?.startsWith('GP-'))
        .sort((a, b) => getTicketNumber(b.data.ticketId) - getTicketNumber(a.data.ticketId));
  return paginate(gpPosts, { pageSize: 20, props: { allPostsFull } });
}

const { page, allPostsFull } = Astro.props;
const getTimelineStyle = (status: PostStatus) =>
  status === 'published' ? undefined : 'opacity: 0.6; filter: grayscale(0.22);';
---

<BaseLayout title="Gu-log Picks - All Posts" lang="en">
  <h1><img src="/gu-log-icon-trimmed.png" alt="" class="page-icon" /> Gu-log Picks</h1>
  {
    GP_SERIES_PAUSED ? (
      <p class="gp-paused-notice" data-gp-paused-notice>
        {getGpPausedNotice('en')}
      </p>
    ) : (
      <Fragment>
        <p class="page-subtitle">Long-form articles, translated and explained</p>
        <p class="post-count">{page.total} posts</p>
      </Fragment>
    )
  }

  <a href="/en" class="back-link">← Back to home</a>

  <section class="archive-list">
    {
      page.data.map((post) => {
        const status = getPostStatus(post, allPostsFull);
        return (
          <article class="post-preview" style={getTimelineStyle(status)}>
            <h3>
              <a href={`/en/posts/${post.id}`}>
                {post.data.title}
                {status !== 'published' && <PostStatusLabel status={status} />}
              </a>
            </h3>
            <p class="post-meta">
              {post.data.ticketId && <TicketBadge ticketId={post.data.ticketId} />}
              {post.data.translatedDate || post.data.originalDate} · From {post.data.source}
            </p>
            <Toggle title="Preview">
              <p>{post.data.summary}</p>
            </Toggle>
          </article>
        );
      })
    }
  </section>

  <Pagination page={page} lang="en" />
</BaseLayout>

<style>
  .page-icon {
    width: 44px;
    height: 44px;
    vertical-align: middle;
    margin-right: 0.5rem;
  }

  .gp-paused-notice {
    margin: 0.75rem 0 1.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    color: var(--color-mogu-note-text);
    line-height: 1.7;
  }

  .page-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .post-count {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .back-link {
    display: inline-block;
    color: var(--color-accent);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .archive-list {
    margin-bottom: 2rem;
  }

  .post-preview {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-preview h3 {
    margin-bottom: 0.25rem;
  }

  .post-preview h3 a {
    color: var(--color-text);
  }

  .post-preview h3 a:hover {
    color: var(--color-accent);
  }
</style>
